<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.VIBRATE" />
    <application>
        <!-- The system keyboard. Users turn it on in Settings > Keyboards; the label is the app's name. -->
        <service
            android:name="dev.pyxpo.modules.keyboard.KeyboardService"
            android:label="${pyxpoName}"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/px_keyboard_method" />
        </service>
    </application>
</manifest>
